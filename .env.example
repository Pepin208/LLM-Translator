# Copy to .env and fill in the values you need. Never commit real keys.
#
# Paths and server
# TRANSLATOR_BASE=/absolute/path/to/data
# TRANSLATOR_CONFIG=/absolute/path/to/translator_config.json
# TRANSLATOR_STATIC=/absolute/path/to/frontend/static
# PORT=21346
# OPENROUTER_REFERER=https://github.com/Pepin208/LLM-Translator

# Provider API keys (these override values in translator_config.json)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENCODE_API_KEY=
