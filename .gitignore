# Go build artifacts
/bin/
*.exe
*.out

# Local TLS material (never commit private keys)
/key.pem
/cert.pem

# Live config with API keys and auth material
/translator_config.json

# Runtime data (uploads, outputs, generated glossaries)
/web_storage/

# Python artifacts (the legacy Python tree lives outside this repo; kept here
# so the patterns still apply if the repo is ever widened to the parent dir)
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
