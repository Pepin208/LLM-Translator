# Go build artifacts (binaries are built at the repo root by start.sh)
/bin/
*.exe
*.out
*.test
coverage.out

# Local TLS material (never commit private keys)
/key.pem
/cert.pem

# Live config with API keys and auth material
/translator_config.json

# Runtime data (uploads, outputs, generated glossaries)
/web_storage/

# Server log
/translator_log.txt

# Build fingerprints written by start.sh
/.build-hash
/.build-hash-static

# Local agent instructions (kept out of the public repo)
/AGENTS.md

# Frozen Python original: kept for reference only, not part of the active project
/legacy/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
